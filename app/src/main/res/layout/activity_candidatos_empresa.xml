<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pipeline de seleção"
                    style="@style/T.Eyebrow" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Candidatos"
                    style="@style/T.H1"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:elevation="2dp"
                android:layout_marginTop="20dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@null"
                    android:tint="@color/muted" />
                <EditText
                    style="@style/T.Input"
                    android:id="@+id/etBusca"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:hint="Buscar candidato"
                    android:inputType="text"
                    android:imeOptions="actionSearch" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_filter"
                    android:contentDescription="@null"
                    android:tint="@color/navy"
                    android:id="@+id/btnFiltro"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:paddingVertical="14dp"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="48"
                        style="@style/T.Number"
                        android:textSize="22sp"
                        android:textColor="@color/ink"
                        android:id="@+id/tvInscritos" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inscritos"
                        style="@style/T.Small"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selected"
                    android:paddingVertical="14dp"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        style="@style/T.Number"
                        android:textSize="22sp"
                        android:textColor="@color/blue"
                        android:id="@+id/tvEmAnalise" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Em análise"
                        style="@style/T.Small"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:paddingVertical="14dp"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05"
                        style="@style/T.Number"
                        android:textSize="22sp"
                        android:textColor="@color/ink"
                        android:id="@+id/tvEntrevistas" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entrevistas"
                        style="@style/T.Small"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_tabs"
                android:padding="4dp"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="Novos"
                    style="@style/T.Tab"
                    android:id="@+id/tabNovos"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_selected"
                    android:textColor="@color/ink"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="Favoritos"
                    style="@style/T.Tab"
                    android:id="@+id/tabFavoritos"
                    android:layout_weight="1"
                    android:textColor="@color/muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="Entrevistas"
                    style="@style/T.Tab"
                    android:id="@+id/tabEntrevistas"
                    android:layout_weight="1"
                    android:textColor="@color/muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/llCandidatos" />
        </LinearLayout>
    </ScrollView>
    <include
        layout="@layout/nav_recrutador" />
</LinearLayout>
