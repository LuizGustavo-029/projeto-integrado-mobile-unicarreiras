<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginTop="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_avatar_navy">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LU"
                android:fontFamily="@font/outfit_bold"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/tvAvatar" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lumina"
                    style="@style/T.Body"
                    android:textSize="12sp"
                    android:id="@+id/tvCompany" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOVA"
                    style="@style/T.Badge.Blue"
                    android:textSize="9sp"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:id="@+id/tvNova" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estágio em Product Design"
                android:fontFamily="@font/outfit_semibold"
                android:textSize="14sp"
                android:textColor="@color/ink"
                android:layout_marginTop="3dp"
                android:id="@+id/tvTitle" />
        </LinearLayout>
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_bookmark"
            android:contentDescription="@null"
            android:tint="@color/muted"
            android:id="@+id/btnSalvar"
            android:padding="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />
    </LinearLayout>
    <com.estagiopro.app.widget.FlowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hGap="6dp"
        app:vGap="6dp"
        android:id="@+id/flChips"
        android:layout_marginTop="14dp" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_line"
        android:layout_marginTop="14dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Publicada há 2 dias"
            style="@style/T.Small"
            android:textSize="11sp"
            android:layout_weight="1"
            android:id="@+id/tvPosted" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver vaga"
            android:fontFamily="@font/inter_semibold"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_small_navy"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:id="@+id/btnVerVaga"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />
    </LinearLayout>
</LinearLayout>
