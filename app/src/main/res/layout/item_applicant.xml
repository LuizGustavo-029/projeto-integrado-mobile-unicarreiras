<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layout_marginTop="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_avatar_navy">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AF"
            android:fontFamily="@font/outfit_bold"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/tvAvatar" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_weight="1">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ana Ferreira"
            android:fontFamily="@font/outfit_semibold"
            android:textSize="14sp"
            android:textColor="@color/ink"
            android:id="@+id/tvName" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eng. de Computação · USP"
            style="@style/T.Small"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:id="@+id/tvSub" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="94% match"
            style="@style/T.Badge.Green"
            android:textSize="11sp"
            android:id="@+id/tvMatch"
            android:layout_gravity="end" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enviada"
            style="@style/T.Small"
            android:textSize="11sp"
            android:layout_marginTop="6dp"
            android:layout_gravity="end"
            android:id="@+id/tvStage" />
    </LinearLayout>
</LinearLayout>
