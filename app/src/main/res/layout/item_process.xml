<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginTop="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_avatar_navy">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LU"
                android:fontFamily="@font/outfit_bold"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/tvAvatar" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lumina"
                style="@style/T.Body"
                android:textSize="12sp"
                android:id="@+id/tvCompany" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estágio em Product Design"
                android:fontFamily="@font/outfit_semibold"
                android:textSize="14sp"
                android:textColor="@color/ink"
                android:layout_marginTop="2dp"
                android:id="@+id/tvTitle" />
        </LinearLayout>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="@null"
            android:tint="@color/muted" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">
        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="4dp"
            android:background="@drawable/bg_seg_off"
            android:layout_marginEnd="6dp"
            android:id="@+id/seg1" />
        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="4dp"
            android:background="@drawable/bg_seg_off"
            android:layout_marginEnd="6dp"
            android:id="@+id/seg2" />
        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="4dp"
            android:background="@drawable/bg_seg_off"
            android:layout_marginEnd="6dp"
            android:id="@+id/seg3" />
        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="4dp"
            android:background="@drawable/bg_seg_off"
            android:layout_marginEnd="0dp"
            android:id="@+id/seg4" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Candidatura enviada"
                android:fontFamily="@font/inter_semibold"
                android:textSize="13sp"
                android:textColor="@color/ink"
                android:id="@+id/tvStatus" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviado em 12 mai"
                style="@style/T.Small"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:id="@+id/tvSub" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_badge_orange"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical"
            android:id="@+id/llBadge">
            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_calendar"
                android:contentDescription="@null"
                android:tint="@color/orange_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agendada"
                android:fontFamily="@font/inter_semibold"
                android:textSize="11sp"
                android:textColor="@color/orange_text"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
