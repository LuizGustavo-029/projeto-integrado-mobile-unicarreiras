<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recrutamento e seleção"
                    style="@style/T.Eyebrow" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minhas vagas"
                    style="@style/T.H1"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_btn_gradient"
                android:id="@+id/btnPublicarVaga"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginTop="20dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_plus"
                    android:contentDescription="@null"
                    android:tint="@color/white"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Publicar nova vaga"
                    style="@style/T.Button" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selected"
                    android:paddingVertical="14dp"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="06"
                        style="@style/T.Number"
                        android:textSize="22sp"
                        android:textColor="@color/blue"
                        android:id="@+id/tvAtivas" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ativas"
                        style="@style/T.Small"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:paddingVertical="14dp"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02"
                        style="@style/T.Number"
                        android:textSize="22sp"
                        android:textColor="@color/ink"
                        android:id="@+id/tvRascunhos" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rascunhos"
                        style="@style/T.Small"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:paddingVertical="14dp"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14"
                        style="@style/T.Number"
                        android:textSize="22sp"
                        android:textColor="@color/ink"
                        android:id="@+id/tvEncerradas" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Encerradas"
                        style="@style/T.Small"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_tabs"
                android:padding="4dp"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="Ativas"
                    style="@style/T.Tab"
                    android:id="@+id/tabAtivas"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_selected"
                    android:textColor="@color/ink"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="Rascunhos"
                    style="@style/T.Tab"
                    android:id="@+id/tabRascunhos"
                    android:layout_weight="1"
                    android:textColor="@color/muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="Encerradas"
                    style="@style/T.Tab"
                    android:id="@+id/tabEncerradas"
                    android:layout_weight="1"
                    android:textColor="@color/muted"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/llVagas"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </ScrollView>
    <include
        layout="@layout/nav_recrutador" />
</LinearLayout>
