<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:background="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/white">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient">
                <View
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:background="@drawable/bg_ring"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-50dp"
                    android:layout_marginEnd="-40dp" />
                <View
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:background="@drawable/bg_circle_soft"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="48dp"
                    android:layout_marginEnd="56dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="30dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:id="@+id/btnVoltar"
                        android:layout_marginBottom="18dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_left"
                            android:contentDescription="@null"
                            android:tint="@color/white_70" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voltar"
                            android:textSize="13sp"
                            android:textColor="@color/white_70"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_logo_tile">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_logo"
                                android:contentDescription="@null"
                                android:tint="@color/white"
                                android:layout_gravity="center" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UniCarreiras"
                            android:fontFamily="@font/outfit_bold"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perfil recrutador"
                        style="@style/T.H1.White"
                        android:layout_marginTop="22dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Encontre talentos e fortaleça sua marca"
                        android:textSize="14sp"
                        android:textColor="@color/white_70"
                        android:layout_marginTop="6dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="22dp">
                        <View
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="3dp"
                            android:background="@drawable/bg_seg_white"
                            android:layout_marginEnd="8dp" />
                        <View
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="3dp"
                            android:background="@drawable/bg_seg_white_off" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1/2"
                            android:textSize="11sp"
                            android:textColor="@color/white_70"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:layout_weight="1"
                android:paddingHorizontal="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="20dp"
                android:background="@color/white">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIPO DE ORGANIZAÇÃO"
                    style="@style/T.Label"
                    android:layout_marginTop="16dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_btn_outline"
                        android:paddingHorizontal="14dp"
                        android:id="@+id/optEmpresa"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginEnd="12dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_briefcase"
                            android:contentDescription="@null"
                            android:tint="@color/muted" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Empresa"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="13sp"
                            android:textColor="@color/chip_text"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_option_selected"
                        android:paddingHorizontal="14dp"
                        android:id="@+id/optInstituicao"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_building"
                            android:contentDescription="@null"
                            android:tint="@color/navy" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Instituição"
                            android:fontFamily="@font/inter_semibold"
                            android:textSize="13sp"
                            android:textColor="@color/navy"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check"
                            android:contentDescription="@null"
                            android:tint="@color/blue" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOME DA ORGANIZAÇÃO"
                    style="@style/T.Label"
                    android:layout_marginTop="18dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_building"
                        android:contentDescription="@null"
                        android:tint="@color/muted" />
                    <EditText
                        style="@style/T.Input"
                        android:id="@+id/etOrganizacao"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:hint="Universidade Central"
                        android:inputType="textCapWords" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CNPJ"
                    style="@style/T.Label"
                    android:layout_marginTop="16dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_briefcase"
                        android:contentDescription="@null"
                        android:tint="@color/muted" />
                    <EditText
                        style="@style/T.Input"
                        android:id="@+id/etCnpj"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:hint="00.000.000/0001-00"
                        android:inputType="text" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E-MAIL CORPORATIVO"
                    style="@style/T.Label"
                    android:layout_marginTop="16dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_mail"
                        android:contentDescription="@null"
                        android:tint="@color/muted" />
                    <EditText
                        style="@style/T.Input"
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:hint="talentos@organizacao.com.br"
                        android:inputType="textEmailAddress" />
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_gradient"
                    android:id="@+id/btnContinuar"
                    android:elevation="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginTop="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Continuar"
                        style="@style/T.Button" />
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="@null"
                        android:tint="@color/white"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cadastro sujeito à validação dos dados da organização."
                    style="@style/T.Small"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
