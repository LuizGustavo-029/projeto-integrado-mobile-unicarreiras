<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient">
                <View
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_ring"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-40dp"
                    android:layout_marginEnd="-30dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="24dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Meu perfil"
                            android:textSize="13sp"
                            android:textColor="@color/white_70" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ana Luiza Ferreira"
                            style="@style/T.H1.White"
                            android:textSize="22sp"
                            android:layout_marginTop="2dp"
                            android:id="@+id/tvNomeHeader" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Editar"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_btn_header"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="9dp"
                        android:id="@+id/btnEditarPerfil"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:elevation="4dp">
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_avatar_light">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AL"
                            android:fontFamily="@font/outfit_bold"
                            android:textSize="20sp"
                            android:textColor="@color/navy"
                            android:layout_gravity="center"
                            android:id="@+id/tvAvatar" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ana Luiza Ferreira"
                            android:fontFamily="@font/outfit_bold"
                            android:textSize="16sp"
                            android:textColor="@color/ink"
                            android:id="@+id/tvNome" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Engenharia de Computação · 6º semestre"
                            style="@style/T.Small"
                            android:textSize="12sp"
                            android:layout_marginTop="3dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:id="@+id/tvSub" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_badge_green"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_check"
                                android:contentDescription="@null"
                                android:tint="@color/green_text" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perfil 75% completo"
                                android:fontFamily="@font/inter_semibold"
                                android:textSize="11sp"
                                android:textColor="@color/green_text"
                                android:layout_marginStart="6dp"
                                android:id="@+id/tvBadge" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Sobre mim"
                            android:fontFamily="@font/outfit_semibold"
                            android:textSize="14sp"
                            android:textColor="@color/ink"
                            android:layout_weight="1" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Editar"
                            style="@style/T.Link"
                            android:id="@+id/btnEditarSobre"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estudante apaixonada por tecnologia e produtos digitais, buscando experiências em design e desenvolvimento."
                        android:textSize="14sp"
                        android:textColor="@color/muted"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:id="@+id/tvSobre" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Formação acadêmica"
                            android:fontFamily="@font/outfit_semibold"
                            android:textSize="14sp"
                            android:textColor="@color/ink"
                            android:layout_weight="1" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Editar"
                            style="@style/T.Link"
                            android:id="@+id/btnEditarFormacao"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp">
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_tile">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_building"
                                android:contentDescription="@null"
                                android:tint="@color/navy"
                                android:layout_gravity="center" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Universidade de São Paulo"
                                style="@style/T.Name"
                                android:textSize="13sp"
                                android:id="@+id/tvUniversidade" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Engenharia de Computação · 2022–2027"
                                style="@style/T.Small"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"
                                android:id="@+id/tvCursoPeriodo" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Competências"
                            android:fontFamily="@font/outfit_semibold"
                            android:textSize="14sp"
                            android:textColor="@color/ink"
                            android:layout_weight="1" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ Adicionar"
                            style="@style/T.Link"
                            android:id="@+id/btnAdicionarCompetencia"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />
                    </LinearLayout>
                    <com.estagiopro.app.widget.FlowLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hGap="8dp"
                        app:vGap="8dp"
                        android:id="@+id/flSkills"
                        android:layout_marginTop="14dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Currículo"
                            android:fontFamily="@font/outfit_semibold"
                            android:textSize="14sp"
                            android:textColor="@color/ink"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_input"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp"
                        android:id="@+id/btnCurriculo"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_card">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_file"
                                android:contentDescription="@null"
                                android:tint="@color/blue"
                                android:layout_gravity="center" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Currículo_Ana_Luiza.pdf"
                                style="@style/T.Name"
                                android:textSize="13sp"
                                android:id="@+id/tvCvNome" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Atualizado em 10 mai · 1,2 MB"
                                style="@style/T.Small"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp"
                                android:id="@+id/tvCvInfo" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@null"
                            android:tint="@color/muted" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_danger"
                    android:layout_marginTop="16dp"
                    android:id="@+id/btnSair"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sair da conta"
                        android:fontFamily="@font/outfit_semibold"
                        android:textSize="14sp"
                        android:textColor="@color/red" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include
        layout="@layout/nav_aluno" />
</LinearLayout>
