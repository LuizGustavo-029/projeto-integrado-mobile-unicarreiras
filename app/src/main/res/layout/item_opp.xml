<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_avatar_navy">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LU"
                android:fontFamily="@font/outfit_bold"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/tvAvatar" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lumina Tecnologia"
                style="@style/T.Body"
                android:textSize="11sp"
                android:id="@+id/tvCompany" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Programa de Estágio 2025"
                android:fontFamily="@font/outfit_semibold"
                android:textSize="15sp"
                android:textColor="@color/ink"
                android:layout_marginTop="2dp"
                android:id="@+id/tvTitle" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engenharias e Design"
                style="@style/T.Small"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:id="@+id/tvSub" />
        </LinearLayout>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="@null"
            android:tint="@color/muted"
            android:layout_gravity="top" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_strip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Interesse dos alunos"
            style="@style/T.Small"
            android:textSize="11sp"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="42 interessados"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp"
            android:textColor="@color/ink"
            android:id="@+id/tvInteresse" />
    </LinearLayout>
</LinearLayout>
